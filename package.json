{
  "name": "schedule",
  "description": "DSH Desktop 桌面小组件：每日时间安排（周期重复 + 起止时间 + 倒计时便签）、目标设置（进度百分比 + 自由流程图工作台）、日期规划（跨天任务月历）三个可拖动、可缩放、自动记忆位置的悬浮卡片。纯前端 vanilla DOM 实现，localStorage 持久化，零依赖。",
  "version": "0.16.7",
  "author": "Nicercz007-cloud",
  "homepage": "https://github.com/Nicercz007-cloud/schedule#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/Nicercz007-cloud/schedule.git"
  },
  "bugs": {
    "url": "https://github.com/Nicercz007-cloud/schedule/issues"
  },
  "keywords": [
    "dsh-plugin",
    "schedule",
    "desktop-widgets",
    "calendar",
    "todo",
    "goals",
    "productivity"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.1.2-alpha.3"
    },
    "bundle": {
      "id": "schedule",
      "name": "Schedule Widgets",
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "license": "MIT",
  "dependencies": {},
  "files": [
    "lib",
    "cordis.patch.yml",
    "screenshots.json"
  ]
}
